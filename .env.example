# -----------------------------------------------------------------------------
# Top5Ideals environment variables. Copy to .env.local for local development.
# Never commit real values. The application needs NO service-role key.
# -----------------------------------------------------------------------------

# Supabase project (Project Settings → API). Safe to expose to the browser:
# all access is enforced by Row Level Security and SECURITY DEFINER functions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key ("sb_publishable_...") or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Canonical public URL (no trailing slash). Used for metadata, sitemap and auth
# email redirects. On Vercel previews VERCEL_URL is used automatically if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Test-only variables (never set these in production). See docs/TESTING.md.
# -----------------------------------------------------------------------------
# Playwright end-to-end tests
E2E_BASE_URL=
E2E_SELLER_EMAIL=
E2E_SELLER_PASSWORD=
E2E_BUYER_EMAIL=
E2E_BUYER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Real-Postgres concurrency test (tests/integration) against a TEST project
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
TEST_SELLER_EMAIL=
TEST_SELLER_PASSWORD=
TEST_BUYER_EMAIL=
TEST_BUYER_PASSWORD=
TEST_BUYER2_EMAIL=
TEST_BUYER2_PASSWORD=
TEST_TARGET_LISTING_ID=
